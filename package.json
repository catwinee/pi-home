{
  "name": "@catwinee/pi-home",
  "version": "0.2.2",
  "description": "Pi startup overview, cwd session browser, read-only artifact inventory and recoverable session cleanup.",
  "type": "module",
  "main": "./src/index.ts",
  "files": ["src", "README.md", "docs", "LICENSE", "NOTICE", "CHANGELOG.md"],
  "keywords": ["pi-package", "pi-extension", "sessions", "dashboard", "heatmap"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "smoke": "tsx tests/smoke.ts",
    "benchmark": "tsx tests/benchmark.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/catwinee/pi-home.git" }
}
